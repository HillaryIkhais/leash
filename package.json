{
  "name": "leash",
  "displayName": "LEASH",
  "private": true,
  "description": "LEASH — run-scoped authority contracts for autonomous agents. Parent, child, and MCP callers enforced against one live, attenuated, expiring, revocable contract.",
  "type": "module",
  "scripts": {
    "migrate:production": "tsx scripts/migrate-production.ts",
    "dev": "agent-native dev --open",
    "build": "agent-native build",
    "start": "agent-native start",
    "typecheck": "agent-native typecheck",
    "action": "agent-native action",
    "script": "agent-native script",
    "test": "node --experimental-transform-types --import ./tests/register-ts-resolve.mjs --test tests/leash-engine.node.ts tests/leash-enforce.node.ts",
    "demo": "node --experimental-transform-types --import ./tests/register-ts-resolve.mjs scripts/leash-demo.ts",
    "test:vitest": "vitest --run --passWithNoTests"
  },
  "dependencies": {
    "@agent-native/agentkit": "0.226.0",
    "@agent-native/core": "0.226.0",
    "@agent-native/otel": "0.1.35",
    "@agent-native/toolkit": "0.226.0",
    "@electric-sql/pglite": "^0.5.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.99.2",
    "ai": "6.0.258",
    "drizzle-orm": "^0.45.3",
    "h3": "^2.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.1.0",
    "sonner": "^2.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@react-router/dev": "^8.1.0",
    "@react-router/fs-routes": "^8.1.0",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.2.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.20.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "8.1.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.29.1"
